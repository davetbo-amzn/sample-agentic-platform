   "source": [
    "from agentic_platform.service.agentcore.types import CreateEventRequest, CreateEventResponse\n",
    "import boto3\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "def create_actor_id(): \n",
    "    # you can create the actor ID to be anything you want. Here we \n",
    "    sts = boto3.client('sts')\n",
    "    return 'actor-' + sts.get_caller_identity()['Arn'].split(':sts::')[1].replace('::', '-').\\\n",
    "        replace(':', '-').replace('/', '-')\n",
    "    \n",
    "def create_session_id():\n",
    "    return 'session-' + datetime.now(timezone.utc).isoformat().\\\n",
    "        split('+')[0].replace('.', '-').replace(':', '-') + 'Z'\n",
    "\n",
    "actor_id = create_actor_id()\n",
    "session_id = create_session_id()\n",
    "print(f\"Created actor_id {actor_id} and session_id {session_id}\")"
   ]
