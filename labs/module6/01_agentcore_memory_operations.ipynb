    "from agentic_platform.service.agentcore.memory.client.agentcore_memory_client import AgentCoreMemoryClient\n",
    "from agentic_platform.service.agentcore.types import CreateMemoryProviderRequest, CreateMemoryProviderResponse\n",
    "\n",
    "ac = AgentCoreMemoryClient()\n",
    "response: CreateMemoryProviderResponse = ac.create_memory_provider(CreateMemoryProviderRequest(\n",
    "    name='agentpath-labs-module6-memory',\n",
    "    retention_days=7\n",
    "))\n",
    "print(response)\n",
    "agentcore_memory_id = response.memory_id\n",
