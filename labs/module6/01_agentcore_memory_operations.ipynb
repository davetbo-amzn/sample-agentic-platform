    "def test_memory_lambda_cloudwatch_logs():\n",
    "    \"\"\"Test that Memory Lambda function generates CloudWatch logs.\"\"\"\n",
    "    print(\"\\n=== Testing CloudWatch Logs ===\")\n",
    "    \n",
    "    # Construct log group name\n",
    "    log_group_name = f\"/aws/lambda/{memory_lambda_function}\"\n",
    "    \n",
    "    try:\n",
    "        # Check if log group exists\n",
    "        response = logs_client.describe_log_groups(\n",
    "            logGroupNamePrefix=log_group_name,\n",
    "            limit=1\n",
    "        )\n",
    "        \n",
    "        log_groups = response.get(\"logGroups\", [])\n",
    "        if log_groups:\n",
    "            log_group = log_groups[0]\n",
    "            assert log_group[\"logGroupName\"] == log_group_name, \"Log group name mismatch\"\n",
    "            print(f\"✅ CloudWatch log group exists: {log_group_name}\")\n",
    "            \n",
    "            # Try to get recent log streams\n",
    "            streams_response = logs_client.describe_log_streams(\n",
    "                logGroupName=log_group_name,\n",
    "                orderBy=\"LastEventTime\",\n",
    "                descending=True,\n",
    "                limit=5\n",
    "            )\n",
    "            \n",
    "            log_streams = streams_response.get(\"logStreams\", [])\n",
    "            if log_streams:\n",
    "                print(f\"   Found {len(log_streams)} recent log streams\")\n",
    "                latest_stream = log_streams[0]\n",
    "                if \"lastEventTime\" in latest_stream:\n",
    "                    last_event_time = datetime.fromtimestamp(latest_stream[\"lastEventTime\"] / 1000)\n",
    "                    print(f\"   Latest log event: {last_event_time}\")\n",
    "            else:\n",
    "                print(f\"   No log streams found (function may not have been invoked recently)\")\n",
    "                \n",
    "            return True\n",
    "        else:\n",
    "            print(f\"⚠️  Log group {log_group_name} not found (function may not have been invoked)\")\n",
    "            return True  # This is acceptable\n",
    "            \n",
    "    except ClientError as e:\n",
    "        print(f\"⚠️  Could not access CloudWatch logs: {e}\")\n",
    "        return True  # This is acceptable - may be permissions issue\n",
    "    except Exception as e:\n",
    "        print(f\"❌ Test failed with exception: {e}\")\n",
    "        return False\n",
    "\n",
    "# Run the test\n",
    "logs_test_result = test_memory_lambda_cloudwatch_logs()\n",
    "print(f\"CloudWatch logs test result: {logs_test_result}\")"
   ]
