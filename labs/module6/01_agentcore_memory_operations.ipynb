    "def get_terraform_outputs() -> Dict[str, Any]:\n",
    "    \"\"\"Get Terraform outputs for deployed resources.\"\"\"\n",
    "    try:\n",
    "        # Path to the agentcore terraform stack\n",
    "        terraform_dir = Path(\"../../infrastructure/stacks/agentcore\")\n",
    "        \n",
    "        if not terraform_dir.exists():\n",
    "            print(f\"Terraform directory not found: {terraform_dir}\")\n",
    "            return {}\n",
    "        \n",
    "        result = subprocess.run(\n",
    "            [\"terraform\", \"output\", \"-json\"],\n",
    "            cwd=terraform_dir,\n",
    "            capture_output=True,\n",
    "            text=True,\n",
    "            timeout=30\n",
    "        )\n",
    "        \n",
    "        if result.returncode == 0:\n",
    "            outputs = json.loads(result.stdout)\n",
    "            print(f\"Retrieved Terraform outputs: {list(outputs.keys())}\")\n",
    "            return outputs\n",
    "        else:\n",
    "            print(f\"Terraform output failed: {result.stderr}\")\n",
    "            return {}\n",
    "            \n",
    "    except Exception as e:\n",
    "        print(f\"Error getting Terraform outputs: {e}\")\n",
    "        return {}\n",
    "\n",
    "def discover_memory_lambda_function() -> str:\n",
    "    \"\"\"Discover the deployed memory Lambda function.\"\"\"\n",
    "    # Try Terraform outputs first\n",
    "    terraform_outputs = get_terraform_outputs()\n",
    "    \n",
    "    if terraform_outputs and 'bedrock_agentcore_memory_lambda_function_name' in terraform_outputs:\n",
    "        function_name = terraform_outputs['bedrock_agentcore_memory_lambda_function_name']['value']\n",
    "        print(f\"Found memory Lambda from Terraform: {function_name}\")\n",
    "        return function_name\n",
    "    \n",
    "    # Fallback to discovery via Lambda API\n",
    "    try:\n",
    "        response = lambda_client.list_functions()\n",
    "        for function in response.get(\"Functions\", []):\n",
    "            function_name = function[\"FunctionName\"]\n",
    "            if \"agentcore-memory-setup\" in function_name:\n",
    "                print(f\"Discovered memory Lambda: {function_name}\")\n",
    "                return function_name\n",
    "    except Exception as e:\n",
    "        print(f\"Error discovering Lambda functions: {e}\")\n",
    "    \n",
    "    raise Exception(\"Could not find deployed memory Lambda function. Ensure AgentCore infrastructure is deployed.\")\n",
    "\n",
    "# Discover the deployed function\n",
    "memory_lambda_function = discover_memory_lambda_function()\n",
    "print(f\"Using memory Lambda function: {memory_lambda_function}\")"
